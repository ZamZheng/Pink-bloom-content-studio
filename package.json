{
  "name": "pink-bloom-content-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Pink Bloom 患者康复知识卡片本地图文排版器",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup:browser": "playwright install chromium",
    "setup:browser:deps": "playwright install-deps chromium",
    "render": "node scripts/render-v04.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/render-v04.mjs --preview",
    "render:legacy": "node scripts/render.mjs",
    "preview:legacy": "node scripts/render.mjs --preview"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/noto-serif-sc": "5.3.1",
    "playwright": "1.65.1"
  }
}
